# 方案二: four A100-SXM4-80GB devices.  The measured TP8 model allocation was
# 19.81 GiB/GPU and the final-profile KV estimate was 19.58 full 256K contexts.
# TP4 doubles the weight shard to about 39.62 GiB/GPU.  Holding the measured
# non-KV reserve constant leaves roughly 30.02 GiB/GPU for KV, or 11.80 full
# 256K contexts.  max-num-seqs=16 is the requested conservative queue ceiling
# (about 1.36 x the resident estimate); the performance grid is reduced in
# proportion to GPU count from C1..16 to C1..8.
SCHEME_ID=two
SCHEME_LABEL='方案二（4 卡，GPU 4-7）'
GPU_DEVICES=4,5,6,7
GPU_COUNT=4
TENSOR_PARALLEL_SIZE=4
# TP4 owns 16 local sparse-MLA query heads per rank.  BLOCK_M=8 would create
# the same 128-row query tile that needs 204800 B of shared memory, above the
# A100 limit of 166912 B.  BLOCK_M=4 preserves the blocked prefill path while
# keeping the tile at the TP8-tested 64-row geometry.
VLLM_SPARSE_DENSE_QUERY_BLOCK=4
CONTAINER_NAME=dsv4-target-r1-two-20260820
ALTERNATE_CONTAINER_NAME=dsv4-target-r1-20260820
MAX_NUM_SEQS=16
BENCHMARK_MAX_CONCURRENCY=8
BENCHMARK_MATRIX_CELLS=160
STABILITY_CONCURRENCY=16
THEORETICAL_256K_CONCURRENCY=11.80
SCHEDULER_TO_THEORETICAL_RATIO=1.36
REPORT_BASENAME=performance-report-two
REPORT_CONTAINER_NAME=dsv4-target-r1-report-two
REPORT_PORT_DEFAULT=8016
