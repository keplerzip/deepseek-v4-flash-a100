# Immutable runtime identity. The base tag is verified byte-for-byte and is
# never retagged, overwritten, or removed by this project.
BASE_IMAGE=dsv4-a100:1281004-base
R1_IMAGE=dsv4-a100:1281004-r1-20260820
SOURCE_TEST_IMAGE=dsv4-a100:1281004-r1-tests-20260820
BASE_VLLM_COMMIT=12810046c799cbe874967e19b1c0fa134ab7b209
R1_RELEASE=2026.08.20-r1
MIN_NVIDIA_DRIVER=580.126.20

# Shared target-only deployment contract.  GPU placement, tensor parallelism,
# scheduler capacity, and benchmark load are selected by config/schemes/*.env.
# There is deliberately no speculative configuration in either scheme.
MODEL_DIR=${MODEL_DIR:-/ai/models/deepseek-v4-flash-0731-modelscope}
CONTAINER_MODEL_DIR=/models/deepseek-v4-flash-0731
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.92}
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=256
SHM_SIZE=${SHM_SIZE:-64g}

# The first name is returned in responses. The same server also advertises a
# claude-prefixed alias for Claude Code gateway discovery and custom selection.
SERVED_MODEL_NAME=deepseek-v4-flash-0731-target
CLAUDE_MODEL_ALIAS=claude-deepseek-v4-flash-0731-target
# Bind every interface only inside the isolated inference container. Docker
# publishes this port to host loopback and the default bridge gateway, never
# to the host LAN interface.
HOST=${HOST:-0.0.0.0}
PORT=${PORT:-8005}
API_PROBE_HOST=127.0.0.1
HOST_PUBLISH_ADDRESS=127.0.0.1
NETWORK_MODE=bridge

STARTUP_TIMEOUT_SECONDS=${STARTUP_TIMEOUT_SECONDS:-7200}
HEALTH_POLL_SECONDS=${HEALTH_POLL_SECONDS:-10}
EXECUTION_MODE=${EXECUTION_MODE:-graph}
RUNTIME_BASE=${RUNTIME_BASE:-/var/tmp/dsv4-target-r1-20260820}

# Both schemes use the same host endpoint and overlap on GPUs 4-7, so only one
# inference service may run at a time.  Names are fixed here for safe switching.
SCHEME_ONE_CONTAINER_NAME=dsv4-target-r1-20260820
SCHEME_TWO_CONTAINER_NAME=dsv4-target-r1-two-20260820

# Offline and privacy defaults.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
