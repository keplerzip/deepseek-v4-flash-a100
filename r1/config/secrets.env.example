# Copy to r1/config/secrets.env only when overriding the defaults.
MODEL_DIR=/ai/models/deepseek-v4-flash-0731-modelscope
# Leave empty only when binding exclusively to a trusted loopback interface.
DSV4_API_KEY=replace-with-a-long-random-value
# Optional writable base owned by the current user.  The launcher appends
# /one or /two so both schemes keep independent logs, cache, and results.
# RUNTIME_BASE=/var/tmp/dsv4-target-r1-20260820
