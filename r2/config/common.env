# R2 runtime identity. The target machine only loads this precompiled image.
R2_IMAGE=dsv4-a100:20260826-r2-sm80
R2_SOURCE_COMMIT=9667db18a628ba4505ad19529df84e09b250b1f3
R2_RELEASE=2026.08.26-r2
MIN_NVIDIA_DRIVER=580.126.20

MODEL_DIR=${MODEL_DIR:-/ai/models/deepseek-v4-flash-0731-modelscope}
CONTAINER_MODEL_DIR=/models/deepseek-v4-flash-0731
MAX_MODEL_LEN=1048576
SHORT_MODEL_MAX_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.92}
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=256
SHM_SIZE=${SHM_SIZE:-64g}

# One TP8 engine advertises four API names. The two names without [1M] are
# enforced at 256K by the R2 per-alias limit patch; all four share one KV pool.
SERVED_MODEL_MAX_LENS='{"deepseek-v4-flash":262144,"deepseek-v4-flash[1M]":1048576,"deepseek-v4-flash-claude":262144,"deepseek-v4-flash-claude[1M]":1048576}'

# `zero` is the current upstream policy. `legacy` omits the environment
# variable; `32768` keeps branch checkpoints longer. All three are benchmarked
# by cache_profile_gate.sh before a production default is accepted.
PREFIX_CACHE_PROFILE=${PREFIX_CACHE_PROFILE:-zero}

# The API listens on all interfaces only inside its container. Docker publishes
# it to host loopback and the default bridge gateway, never the host LAN IP.
HOST=0.0.0.0
PORT=${PORT:-8005}
HOST_PUBLISH_ADDRESS=127.0.0.1
API_PROBE_HOST=127.0.0.1
NETWORK_MODE=bridge

GPU_DEVICES=0,1,2,3,4,5,6,7
GPU_COUNT=8
TENSOR_PARALLEL_SIZE=8
EXECUTION_MODE=${EXECUTION_MODE:-graph}
STARTUP_TIMEOUT_SECONDS=${STARTUP_TIMEOUT_SECONDS:-7200}
HEALTH_POLL_SECONDS=${HEALTH_POLL_SECONDS:-10}
RUNTIME_BASE=${RUNTIME_BASE:-/var/tmp/dsv4-a100-r2-20260826}

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
