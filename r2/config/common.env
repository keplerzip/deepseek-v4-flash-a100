# Operator-local settings. Release-owned engine, network, identity and alias
# values live in release.env, which is sourced after secrets.env.
MODEL_DIR=${MODEL_DIR:-/ai/models/deepseek-v4-flash-0731-modelscope}
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.92}
SHM_SIZE=${SHM_SIZE:-64g}

# `zero` is the current upstream policy. `legacy` omits the environment
# variable; `32768` keeps branch checkpoints longer. All three are benchmarked
# by cache_profile_gate.sh before a production default is accepted.
PREFIX_CACHE_PROFILE=${PREFIX_CACHE_PROFILE:-zero}

EXECUTION_MODE=${EXECUTION_MODE:-graph}
STARTUP_TIMEOUT_SECONDS=${STARTUP_TIMEOUT_SECONDS:-7200}
HEALTH_POLL_SECONDS=${HEALTH_POLL_SECONDS:-10}
RUNTIME_BASE=${RUNTIME_BASE:-/var/tmp/dsv4-a100-r2.1-20260830}
