# R2.3 immutable release contract. lib.sh sources this file after secrets.env,
# so target-local settings cannot alter engine shape, aliases or network scope.
R2_IMAGE=dsv4-a100:20260830-r2.3-sm80
R2_SOURCE_COMMIT=cf7898691b58820a8ba98e018f612d4a0c2f69f0
R2_RELEASE=2026.08.30-r2.3
MIN_NVIDIA_DRIVER=580.126.20

CONTAINER_MODEL_DIR=/models/deepseek-v4-flash-0731
MAX_MODEL_LEN=1048576
SHORT_MODEL_MAX_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=4096
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=256

# One TP8 engine advertises four API names. The two names without [1M] are
# enforced at 256K by the per-alias limit patch; all four share one KV pool.
SERVED_MODEL_MAX_LENS='{"deepseek-v4-flash":262144,"deepseek-v4-flash[1M]":1048576,"deepseek-v4-flash-claude":262144,"deepseek-v4-flash-claude[1M]":1048576}'

# The API listens on all interfaces only inside its container. Docker publishes
# it to host loopback and the default bridge gateway, never the host LAN IP.
HOST=0.0.0.0
PORT=8005
HOST_PUBLISH_ADDRESS=127.0.0.1
API_PROBE_HOST=127.0.0.1
NETWORK_MODE=bridge

GPU_DEVICES=0,1,2,3,4,5,6,7
GPU_COUNT=8
TENSOR_PARALLEL_SIZE=8

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
