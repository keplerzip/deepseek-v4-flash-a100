# Canonical production configuration selected after the 2026-08-13 A100 tests.
# This file contains no secrets and is consumed by start-production.sh.
DSV4_BIND_HOST=${DSV4_BIND_HOST:-172.17.0.1}
PORT=8005
PROFILE=256k
EXECUTION_MODE=graph
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_BATCHED_TOKENS=4096
KV_CACHE_MEMORY_BYTES=

# The target machine runs DCGM exporter with an all-GPU device request but no
# CUDA compute process. It is explicitly allowed; nvidia-smi compute processes,
# any other GPU container, the port, and the project lock still block startup.
GPU_GUARD_ALLOWED_CONTAINERS=${GPU_GUARD_ALLOWED_CONTAINERS:-gpu-monitor-dcgm-exporter}
FORCE_START=0
