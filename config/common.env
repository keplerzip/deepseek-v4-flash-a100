# Shared immutable runtime identity.
IMAGE_NAME=dsv4-a100-vllm:f8ea5bb
IMAGE_ARCHIVE_BASENAME=dsv4-a100-vllm-f8ea5bb
VLLM_REPOSITORY=https://github.com/haosdent/vllm.git
VLLM_COMMIT=f8ea5bb163c161ef38b401d055cc5fd4a934091a

# Both modes are mutually exclusive and intentionally expose the same endpoint.
HOST=${HOST:-127.0.0.1}
PORT=${PORT:-8005}
GPU_DEVICES=${GPU_DEVICES:-0,1,2,3,4,5,6,7}
TENSOR_PARALLEL_SIZE=${TENSOR_PARALLEL_SIZE:-8}
CONTAINER_MODEL_DIR=${CONTAINER_MODEL_DIR:-/models/deepseek-v4-flash-0731}
SHM_SIZE=${SHM_SIZE:-64g}
# Mode-specific defaults are applied by scripts/lib.sh. A caller may override
# any of these before starting. KV_CACHE_MEMORY_BYTES stays empty by default;
# setting it bypasses vLLM's percentage-based KV sizing and requires a separate
# stability test.
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-}
KV_CACHE_MEMORY_BYTES=${KV_CACHE_MEMORY_BYTES:-}

# Safe first boot. Change with scripts/select_profile.sh and EXECUTION_MODE=graph.
PROFILE=${PROFILE:-32k}
EXECUTION_MODE=${EXECUTION_MODE:-eager}
STARTUP_TIMEOUT_SECONDS=${STARTUP_TIMEOUT_SECONDS:-7200}
HEALTH_POLL_SECONDS=${HEALTH_POLL_SECONDS:-10}

# Runtime selection. "auto" tries docker, then sudo -n docker.
CONTAINER_RUNTIME=${CONTAINER_RUNTIME:-auto}
NETWORK_MODE=${NETWORK_MODE:-host}
FORCE_START=${FORCE_START:-0}
SKIP_MODEL_VERIFY=${SKIP_MODEL_VERIFY:-0}
# Exact comma-separated container names that may hold an NVIDIA device request
# without blocking startup. Compute processes and listening ports still block.
GPU_GUARD_ALLOWED_CONTAINERS=${GPU_GUARD_ALLOWED_CONTAINERS:-}

# Prevent any hub access at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false

# Additional arguments are intentionally empty. Set only after checking
# `scripts/verify_image.sh`; Hopper/Blackwell-only options are not supported.
EXTRA_VLLM_ARGS=${EXTRA_VLLM_ARGS:-}
