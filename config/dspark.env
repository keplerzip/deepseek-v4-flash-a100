MODE=dspark
CONTAINER_NAME=dsv4-dspark-f8ea5bb
SERVED_MODEL_NAME=deepseek-v4-flash-0731-dspark
DSPARK_METHOD=dspark
DSPARK_NUM_SPECULATIVE_TOKENS=${DSPARK_NUM_SPECULATIVE_TOKENS:-5}
DSPARK_DRAFT_SAMPLE_METHOD=${DSPARK_DRAFT_SAMPLE_METHOD:-greedy}
SPECULATIVE_CONFIG='{"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"greedy"}'

# DSpark needs runtime workspace in addition to model and KV cache. 0.95 caused
# a reproducible long-context OOM; 0.80 is the conservative field setting.
MODE_GPU_MEMORY_UTILIZATION=0.80
# DSpark max_num_batched_tokens was not independently tuned. Leave empty and
# let the pinned fork derive its speculative scheduling value.
MODE_MAX_NUM_BATCHED_TOKENS=
